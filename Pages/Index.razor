@page "/"

@if(status=="phone")
{

<PhoneVerification
PhoneNumber="@PhoneNumber"
error= "@error"
change="@change"/>
}

@if(status=="otp")
{

<Otp
PhoneNumber="@PhoneNumber"
error= "@error"
varify="@varify"
Code="@Code"
BackPhone="@BackPhone"
/>
}





@code {

string status ="phone";
 string Code;
string PhoneNumber;

string error ="none";
     private void change()
     {

      if(PhoneNumber == null || PhoneNumber =="" || PhoneNumber.Length >11 || PhoneNumber.Length < 11)
      {
           error ="ورود شماره تلفن با فرمت صحیح اجباری است ";
      }else
      {
        status="otp";
        
      }


}

private void varify()
{  
     if(Code==null || Code==""||Code.Length>5 || Code.Length<5)
     {

          error="ورود کد تایید با فرمت صحیح اجباری است ";

                 
     }else
     
     {
        status="confirn";       

     }


}

private void BackPhone()
{

     status="phone";
}

}




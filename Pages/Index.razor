@page "/"

if(status=="phone")
{

<PhoneVerification
PhoneNumber="@PhoneNumber"
error= "@error"
change="@change"


/>


}





@code {

string status ="phone";

string PhoneNumber;

string error ="none";
     private void change()
     {

      if(PhoneNumber == null || PhoneNumber =="" || PhoneNumber.Length >11 || PhoneNumber.Length < 11)
      {
           error ="ورود شماره تلفن با فرمت صحیح اجباری است ";
      }else
      {
        status="otp";
        
      }


}

}


